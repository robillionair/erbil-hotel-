# Supabase Backend Configuration for Erbil Hotel Operations
# Populate these values from your Supabase Project -> Settings -> API
# If left empty, the application automatically runs with its built-in persistent LocalStorage + Realtime Simulator.

VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key
VITE_EXCHANGE_RATE_IQD=1310
